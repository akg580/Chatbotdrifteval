# LLM Provider Configuration
# Options: 'groq' (FREE!), 'anthropic', 'openai'
LLM_PROVIDER=groq

# ===========================================
# GROQ API (FREE & FAST - RECOMMENDED!)
# ===========================================
# Get your FREE API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ===========================================
# Anthropic API (Optional - Paid)
# ===========================================
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# OpenAI API (Optional - Paid)
# ===========================================
# Get your API key from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# INSTRUCTIONS:
# ===========================================
# 1. Choose your provider (groq is FREE!)
# 2. Get an API key from the provider
# 3. Uncomment and fill in your API key
# 4. Set LLM_PROVIDER to match your choice

